# Configuration for generating the API documentation with Doxygen:
#
#     doxygen Doxyfile
#
# This only has what differs from the defaults of Doxygen, so that it keeps
# working with newer versions of it. `doxygen -x Doxyfile` shows what that is.
# See docs/tooling/documentation.md.

PROJECT_NAME           = passgen
PROJECT_BRIEF          = "A password generator with a regex-like syntax."

# the result goes to docs/html (and docs/xml, which scripts/docs_coverage.py
# reads).
OUTPUT_DIRECTORY       = docs
GENERATE_LATEX         = NO
GENERATE_XML           = YES

# what is documented: the public headers, and the main page. the examples
# are included by the main page.
INPUT                  = include/passgen \
                         docs/api.md
FILE_PATTERNS          = *.h \
                         *.h.in \
                         *.md
USE_MDFILE_AS_MAINPAGE = docs/api.md
EXAMPLE_PATH           = examples

# headers are shown as they are included, such as `passgen/random.h`.
STRIP_FROM_PATH        = include/
STRIP_FROM_INC_PATH    = include/

# config.h is generated from config.h.in when building. Doxygen reads the
# template as C, with #cmakedefine turned into #define.
EXTENSION_MAPPING      = in=C
FILTER_PATTERNS        = "*.h.in=sed -e s/^#cmakedefine/#define/"

# macros which the headers depend on: the ChaCha20 sources of randomness are
# only declared with PASSGEN_MONOCYPHER, and PASSGEN_EXPORT only matters to
# the compiler.
MACRO_EXPANSION        = YES
INCLUDE_PATH           = include
PREDEFINED             = PASSGEN_MONOCYPHER \
                         PASSGEN_EXPORT=

# C, with the first sentence of a comment as its brief description, and
# functions listed with the type they belong to (@relatesalso) without
# being shown as its members.
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
HIDE_SCOPE_NAMES       = YES
CASE_SENSE_NAMES       = NO

# the headers can be read, and the pages have no sidebar and no table of
# contents.
SOURCE_BROWSER         = YES
GENERATE_TREEVIEW      = NO
TOC_INCLUDE_HEADINGS   = 0

# graphs of which header includes which, which need graphviz.
HAVE_DOT               = YES
